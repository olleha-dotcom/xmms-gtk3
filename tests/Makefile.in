run-pulse-test.sh.log: run-pulse-test.sh
	@p='run-pulse-test.sh'; \
	b='run-pulse-test.sh'; \
	$(am__check_pre) $(LOG_DRIVER) --test-name "$$f" \
	--log-file $$b.log --trs-file $$b.trs \
