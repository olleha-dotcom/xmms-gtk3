run-gui-test.sh.log: run-gui-test.sh
	@p='run-gui-test.sh'; \
	b='run-gui-test.sh'; \
	$(am__check_pre) $(LOG_DRIVER) --test-name "$$f" \
	--log-file $$b.log --trs-file $$b.trs \
